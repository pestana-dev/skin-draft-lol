{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skin Draft LoL",
  "version": "0.1.6",
  "identifier": "dev.pestana.skindraft",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -w @skin-draft/web",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build -w @skin-draft/web",
      "cwd": "../../.."
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skin Draft LoL",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExN0Y5NDc1OTA3MDhBNkUKUldSdWluQ1FkWlIvb2JlSVU3eTlSTGViS2U0UXZnUkJNbGQ0LzNybCs1VmtFNXVaL2dJNllLN1kK",
      "endpoints": [
        "https://github.com/pestana-dev/skin-draft-lol/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
